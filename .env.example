# Copy to .env (never commit .env) or set these as environment variables.
# All settings are optional: without them the assistant runs fully offline in extractive mode.

# Claude answer generation (optional)
ANTHROPIC_API_KEY=
DOCQA_LLM=auto                 # auto | on | off
DOCQA_LLM_MODEL=claude-opus-5-5
DOCQA_LLM_EFFORT=low

# Use a different document folder (default: ./knowledge_base)
# DOCQA_KB_DIR=D:\path\to\documents
