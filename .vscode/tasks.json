{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Install requirements (first time only)",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "2. Start app (http://localhost:8000)",
      "type": "shell",
      "command": "python -m uvicorn app.api.server:app --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "python tests/test_core.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run evaluation (writes reports/EVALUATION_REPORT.md)",
      "type": "shell",
      "command": "python -m eval.run_eval --split test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
